    <ProjectReference Include="..\GoXlrControl.Engine\GoXlrControl.Engine.csproj" />
    <ProjectReference Include="..\GoXlrControl.Audio\GoXlrControl.Audio.csproj" />
    <ProjectReference Include="..\GoXlrControl.Integrations\GoXlrControl.Integrations.csproj" />
    <ProjectReference Include="..\GoXlrControl.Config\GoXlrControl.Config.csproj" />
